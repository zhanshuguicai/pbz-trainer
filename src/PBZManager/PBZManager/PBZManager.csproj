<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PBZManager</AssemblyName>
    <Version>2.0.1</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="app.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PBZ.Core\PBZ.Core.csproj" />
  </ItemGroup>

  <!-- First-run settings, and the folder the player's songs live in (songs themselves are never shipped). -->
  <ItemGroup>
    <None Update="defaults\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="music\README.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The in-game suite is shipped next to the manager and installed from there. -->
  <ItemGroup>
    <None Include="..\..\PBZSuite\**\*" LinkBase="payload\PBZSuite" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
